# Per-PC settings (each computer keeps its own config)
config.json

# Voice model files (too large for git — auto-downloaded at runtime)
voices/*.onnx
voices/*.onnx.json

# Python cache
__pycache__/
*.pyc
*.pyo

# Virtual environment
.venv/
venv/

# HuggingFace model cache
.cache/

# Per-machine runtime crash log (written by the tool on errors)
error_log.txt

# macOS Finder metadata
.DS_Store
